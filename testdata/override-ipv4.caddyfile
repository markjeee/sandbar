{
	admin "unix/@STATE@/admin.sock"
	storage file_system "@STATE@/caddy"
	persist_config off
	skip_install_trust
	auto_https disable_redirects
	http_port 8080
	https_port 8443
	default_bind 127.0.0.1
	grace_period 5s
	servers {
		protocols h1 h2
	}
	pki {
		ca local {
			name "sandbar local CA"
		}
	}
}

https://netbox.sandbar.localhost:8443 {
	tls internal
	reverse_proxy http://127.0.0.1:8000 {
		header_up Host {hostport}
	}
}

http://netbox.sandbar.localhost:8080 {
	redir https://netbox.sandbar.localhost:8443{uri} 308
}

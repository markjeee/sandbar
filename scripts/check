#!/bin/sh
# The same Go checks run locally and in CI. Outputs stay in the native sandbox.
set -eu
umask 077

integration=0
case "$#:$*" in
    0:) ;;
    1:--integration) integration=1 ;;
    *) echo "Usage: scripts/check [--integration]" >&2; exit 1 ;;
esac

case "$(uname -s):$(uname -m)" in
    Linux:x86_64|Linux:amd64) target_os=linux; target_arch=amd64 ;;
    Darwin:arm64) target_os=darwin; target_arch=arm64 ;;
    *) echo 'Checks require Linux amd64 or macOS arm64.' >&2; exit 1 ;;
esac
# Prevent environment overrides from turning native validation into cross builds.
export GOOS="$target_os" GOARCH="$target_arch"

cgo_enabled=0
if [ "$target_os" = darwin ]; then
    command -v xcrun >/dev/null 2>&1 || { echo 'macOS source builds require Xcode Command Line Tools. Run xcode-select --install.' >&2; exit 1; }
    CC=$(xcrun --find clang) && [ -x "$CC" ] || { echo 'macOS source builds require SDK clang. Run xcode-select --install.' >&2; exit 1; }
    SDKROOT=$(xcrun --sdk macosx --show-sdk-path) && [ -d "$SDKROOT" ] || { echo 'macOS source builds require the macOS SDK. Run xcode-select --install.' >&2; exit 1; }
    export CC SDKROOT
    cgo_enabled=1
    export CGO_ENABLED=1
fi

project_dir=$(CDPATH='' cd -P "$(dirname "$0")/.." && pwd)
cd "$project_dir"
check_dir="$project_dir/.sandbox/check"
tool_dir="$project_dir/.sandbox/tools"
mkdir -p "$check_dir" "$tool_dir"

if [ "$target_os" = darwin ] && [ "$integration" = 1 ]; then
    curl_features=$(curl --version) || { echo 'macOS integration requires curl with HTTP/2 and HTTP/3 support.' >&2; exit 1; }
    printf '%s\n' "$curl_features" | awk '
        /^Features:/ {
            for (i = 2; i <= NF; i++) {
                if ($i == "HTTP2") http2 = 1
                if ($i == "HTTP3") http3 = 1
            }
        }
        END { exit !(http2 && http3) }
    ' || { echo 'macOS integration requires curl with HTTP/2 and HTTP/3 support. Install Homebrew curl and prepend its bin directory to PATH.' >&2; exit 1; }
fi

printf '%s\n' 'Checking formatting and shell syntax'
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
    printf 'Run gofmt on:\n%s\n' "$unformatted" >&2
    exit 1
fi
sh -n scripts/dev
sh -n scripts/check
sh -n scripts/release
sh -n scripts/test-install
sh -n install.sh

printf '%s\n' 'Testing checkout and release installation'
scripts/test-install

printf '%s\n' 'Checking module consistency and vet'
go mod tidy -diff
go vet ./...

printf '%s\n' 'Installing pinned development tools into .sandbox/tools'
# The released x/tools reader supports Go 1.27.2 export data.
staticcheck_build_dir="$tool_dir/staticcheck-build"
mkdir -p "$staticcheck_build_dir"
cat > "$staticcheck_build_dir/go.mod" <<'EOF'
module sandbar-staticcheck-build

go 1.27.2

require (
    honnef.co/go/tools v0.8.1
    golang.org/x/tools v0.50.0
)
EOF
go -C "$staticcheck_build_dir" build -mod=mod -o "$tool_dir/staticcheck" honnef.co/go/tools/cmd/staticcheck
GOBIN="$tool_dir" go install golang.org/x/vuln/cmd/govulncheck@v1.8.0

printf '%s\n' 'Running Staticcheck'
"$tool_dir/staticcheck" ./...

printf '%s\n' 'Running shuffled race tests and collecting in-process coverage'
# GOFLAGS also instruments the CLI binaries built by integration tests.
CGO_ENABLED=1 GOFLAGS="${GOFLAGS:+$GOFLAGS }-race" SANDBAR_INTEGRATION="$integration" \
    go test -count=1 -shuffle=on -timeout=3m -covermode=atomic \
    -coverprofile="$check_dir/coverage.out" ./...
go tool cover -func="$check_dir/coverage.out"

printf '%s\n' 'Fuzzing configuration for 10 seconds with two workers'
SANDBAR_INTEGRATION=0 go test -run='^$' -fuzz='^FuzzConfig$' -fuzztime=10s \
    -parallel=2 -timeout=1m .

printf '%s\n' 'Checking reachable Go vulnerabilities'
"$tool_dir/govulncheck" ./...

printf 'Building the native %s/%s executable\n' "$target_os" "$target_arch"
CGO_ENABLED="$cgo_enabled" go build -trimpath -o "$check_dir/sandbar" .
scripts/release --version v0.1.0-beta.4-candidate
printf 'Checks passed. Coverage: %s/coverage.out\n' "$check_dir"
